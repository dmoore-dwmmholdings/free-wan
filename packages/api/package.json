    "@fastify/static": "8.0.4",
    "@fastify/websocket": "11.0.2",
    "@free-wan/shared": "workspace:*",
    "adm-zip": "0.5.16",
    "better-sqlite3": "11.8.1",
    "chokidar": "4.0.3",
    "drizzle-orm": "0.38.3",
    "fastify": "5.2.1",
    "fastify-plugin": "5.0.1",
    "hash-wasm": "4.12.0",
    "pino": "9.6.0",
    "uuid": "11.0.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.5",
    "drizzle-kit": "0.30.1",
    "pino-pretty": "13.0.0",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
