# Free-WAN environment (Phase 0 scaffold)
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Runtime data dir (SQLite db, thumbs, hls cache, exports, branding assets)
DATA_DIR=./data

# Bootstrap admin (Phase 1) — created on first run; you are forced to change the
# password on first login. If ADMIN_PASSWORD is unset, one is generated and logged.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Secret for signing session cookies (Phase 1) — generate a long random string
SESSION_SECRET=replace-with-a-long-random-secret

# Max failed/total login attempts per IP per minute before 429 (Phase 1)
LOGIN_RATE_MAX=10

# Scanning (Phase 2)
# Debounce (ms) before a filesystem change triggers an incremental rescan
WATCH_DEBOUNCE_MS=1500
# Scheduled full-rescan interval in minutes (0 disables)
RESCAN_INTERVAL_MIN=360

# Custom commands (Phase 9) — comma-separated allowlist of executables a command may run
# (names or absolute paths). Empty = no commands can be defined. Security-critical.
COMMAND_ALLOWED_EXECUTABLES=

# Tailscale sidecar (Phase 10) — reusable auth key for the tailnet
TS_AUTHKEY=

# Trust X-Forwarded-* headers (Phase 10) — set true when behind the Tailscale Serve proxy
TRUST_PROXY=true
