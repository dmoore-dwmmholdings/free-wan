# Free-WAN environment (Phase 0 scaffold)
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Runtime data dir (SQLite db, thumbs, hls cache, exports, branding assets)
DATA_DIR=./data

# Bootstrap admin (Phase 1) — created on first run; you are forced to change the
# password on first login. If ADMIN_PASSWORD is unset, one is generated and logged.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Secret for signing session cookies (Phase 1) — generate a long random string
SESSION_SECRET=replace-with-a-long-random-secret

# Max failed/total login attempts per IP per minute before 429 (Phase 1)
LOGIN_RATE_MAX=10

# Scanning (Phase 2)
# Repositories seeded into an empty DB on first run (thereafter manage in the admin UI).
# Defaults to <repo root>/config/repositories.yaml when unset.
#REPOSITORIES_FILE=./config/repositories.yaml
# Debounce (ms) before a filesystem change triggers an incremental rescan
WATCH_DEBOUNCE_MS=1500
# Scheduled full-rescan interval in minutes (0 disables)
RESCAN_INTERVAL_MIN=360

# HLS transcode cache size cap in MB — least-recently-watched transcodes are evicted past
# this. 0 disables eviction (the admin System panel can still clear the cache manually).
TRANSCODE_CACHE_MAX_MB=2048
# Transcode quality caps (single rendition — no multi-bitrate ladder on a home server).
# Cap the height (e.g. 1080 or 720) and bitrate for slow remote links; 0 keeps source height.
TRANSCODE_MAX_HEIGHT=0
TRANSCODE_MAXRATE_MBPS=6

# Custom commands (Phase 9) — comma-separated allowlist of executables a command may run
# (names or absolute paths). Empty = no commands can be defined. Security-critical.
COMMAND_ALLOWED_EXECUTABLES=

# Plugins (docs/13-plugins.md) — sandboxed server extensions installed by an admin.
# Set false to disable the subsystem entirely. PLUGIN_REGISTRY_URL (optional) points the admin
# UI at a future catalog. PLUGIN_TIMEOUT_S bounds a plugin command/event invocation.
PLUGINS_ENABLED=true
PLUGIN_REGISTRY_URL=
PLUGIN_TIMEOUT_S=120

# Tailscale sidecar (Phase 10) — reusable auth key for the tailnet
TS_AUTHKEY=

# Trust X-Forwarded-* headers (Phase 10) — set true when behind the Tailscale Serve proxy
TRUST_PROXY=true

# Native HTTPS (optional) — make the server speak TLS directly instead of relying on an
# upstream proxy. Set BOTH to PEM file paths. Easiest source is a Tailscale cert:
#   node packages/api/dist/index.js tls-cert   # writes data/tls/<domain>.crt/.key, prints these
# (or run `tailscale cert` yourself). Leave both unset when TLS is terminated by Tailscale Serve.
TLS_CERT_FILE=
TLS_KEY_FILE=
