# Dependencies
node_modules/

# Build output
dist/
coverage/
*.tsbuildinfo

# Runtime data (SQLite db, thumbs, hls cache, exports, branding, uploads)
data/
.verify-data/

# Self-update working dirs and built packages
.fw-update/
release/

# Secrets and local env (.env.example is committed)
.env
.env.local
.env.*.local

# Local sync / editor / OS junk
sync.ffs_db
*.ffs_db
*.ffs_lock
*.log
.DS_Store
Thumbs.db

# Claude local (machine-specific) settings
.claude/settings.local.json
.claude/plans/
.preview-data/
.preview-data-b/

# E2E working state (wiped per run) and Playwright output
e2e/.data/
e2e/.media/
test-results/
playwright-report/

# Local preview rig (sample media + machine-specific launch config)
.preview-media/
.claude/launch.json

# Expo / React Native build state (prebuild output is regenerated, never committed)
.expo/
legacy/mobile-expo/android/
legacy/mobile-expo/ios/
*.jks
*.keystore

# iOS app: the Xcode project is generated from packages/ios/project.yml by XcodeGen
packages/ios/*.xcodeproj/
packages/ios/App/Info.plist
packages/ios/FreeWANKit/.build/
packages/ios/FreeWANKit/.swiftpm/
xcuserdata/
DerivedData/
